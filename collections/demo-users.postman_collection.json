{
  "info": {
    "_postman_id": "8a1f3c0e-0000-4000-8000-000000000001",
    "name": "Demo Users API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "pm.test(\"Response time is acceptable\", function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(3000);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Returns a token\", function () {",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.expect(jsonData.tokenType).to.eql(\"Bearer\");",
                  "});",
                  "pm.environment.set(\"token\", jsonData.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{$randomFirstName}} {{$randomLastName}}\",\n  \"email\": \"{{$randomEmail}}\",\n  \"active\": {{$randomBoolean}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Created\", () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.response.to.have.header(\"Location\");",
                  "});",
                  "const body = pm.response.json();",
                  "pm.expect(body.id).to.be.a('number');",
                  "pm.expect(body.email).to.include('@');",
                  "pm.collectionVariables.set(\"userId\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/:id",
              "variable": [
                {
                  "key": "id",
                  "value": "{{userId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Found\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"userId\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?limit=10"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Has users\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.items.length).to.be.above(0);",
                  "    pm.expect(jsonData.total).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get unknown user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/999999"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Not found\", function () {",
                  "    pm.response.to.be.notFound;",
                  "    pm.expect(pm.response.text()).to.include(\"not found\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Deleted\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 204]); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Create user without token",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"No Auth\", \"email\": \"{{$randomEmail}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Unauthorized\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    }
  ]
}